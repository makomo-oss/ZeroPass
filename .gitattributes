# Normalize line endings to LF in the repository on every platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff2 binary

# Fuzzing seed inputs are byte-exact.
fuzz/seeds/** binary
