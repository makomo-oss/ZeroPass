{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroPass",
  "mainBinaryName": "zeropass",
  "identifier": "io.github.makomo-oss.zeropass",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ZeroPass",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "worker-src": "'none'",
        "manifest-src": "'none'",
        "media-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
